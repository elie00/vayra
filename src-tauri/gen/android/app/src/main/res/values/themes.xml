<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- VAYRA is always dark: a fixed dark theme in Mineral Monochrome, so the
         launch, the recents card and system widgets never flash white or use
         the Material template purple. -->
    <style name="Theme.vayra" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/vayra_titanium</item>
        <item name="colorPrimaryVariant">@color/vayra_graphite</item>
        <item name="colorOnPrimary">@color/vayra_canvas</item>
        <item name="colorSecondary">@color/vayra_titanium</item>
        <item name="colorOnSecondary">@color/vayra_canvas</item>
        <item name="android:windowBackground">@color/vayra_canvas</item>
    </style>
</resources>
