# Shell scripts must keep LF on Windows checkouts (core.autocrlf=true) or bash rejects them.
*.sh text eol=lf
# The Tauri CLI and cargo rewrite these in LF; a CRLF checkout makes every run
# dirty the tree and restarts `tauri dev` through its file watcher.
Cargo.toml text eol=lf
Cargo.lock text eol=lf
# Git runs the versioned hooks with sh, on Windows too.
.githooks/* text eol=lf
# Node scripts start with a shebang; a CRLF checkout leaves "\r" after it, which
# Vitest rejects when a test imports one (src/lib/attribution-policy.test.ts).
scripts/**/*.mjs text eol=lf
