node_modules
dist
dist-ssr
*.local
*.bak
*.tmp.*
_backups/

.env
.env.*
!.env.example

target
/harbor-core/pkg/

# The global excludesfile ignores any `lib/` dir (meant for build output), which
# wrongly catches src/lib — the app's source. Re-include it so new files there
# (i18n locales, player modules, …) are tracked instead of silently dropped.
!/src/lib/

*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

/src-tauri/binaries/stremio-server-*
/src-tauri/binaries/yt-dlp-*
/src-tauri/binaries/ffmpeg*
/src-tauri/binaries/ffprobe*
/src-tauri/binaries/mpv-*
/src-tauri/libmpv/libmpv-2.dll
/src-tauri/fonts/*.otf
/src-tauri/fonts/*.ttf
# Fontshare UI fonts: embedded in the app, not redistributable from the repo (scripts/fetch-ui-fonts.mjs).
/public/fonts/fontshare/
local_docs/
.vercel
.claude/*
!.claude/settings.json
/supabase/.temp/
/.flatpak-work/
/src-tauri/gen/android/buildSrc/.kotlin/

# Le gitignore global de la machine ignore *.sql — ré-inclure les fichiers SQL Supabase (migrations + tests)
!/supabase/**/*.sql
# Source folders named downloads are part of the app, whatever a global gitignore says.
!src/**/downloads/
